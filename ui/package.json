{
  "name": "algoram-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "test:navigation": "node --experimental-strip-types scripts/navigation-check.mjs",
    "test:browser-history": "node --experimental-strip-types scripts/browser-graph-history-check.mjs",
    "perf:navigation": "node --experimental-strip-types scripts/navigation-scale.mjs",
    "test:annotations": "node --experimental-strip-types scripts/annotation-check.mjs",
    "test:presentation": "node --experimental-strip-types scripts/presentation-check.mjs",
    "test:ui-protocol": "node scripts/ui-protocol-check.mjs",
    "test:block-display": "node --experimental-strip-types scripts/block-display-check.mjs",
    "test:platform": "node scripts/browser-platform-check.mjs",
    "test:interaction": "node scripts/smooth-interaction-check.mjs",
    "test:authoring": "node --experimental-strip-types scripts/canonical-authoring-check.mjs",
    "test:validation-parity": "node --experimental-strip-types scripts/graph-validation-parity-check.mjs",
    "test:block-authoring": "node --experimental-strip-types scripts/block-authoring-check.mjs",
    "test:connection-authoring": "node --experimental-strip-types scripts/connection-authoring-check.mjs",
    "test:export": "node --experimental-strip-types scripts/export-graph-check.mjs",
    "test:runtime-bridge": "node --experimental-strip-types scripts/runtime-bridge-check.mjs",
    "test:trace-projection": "node --experimental-strip-types scripts/trace-projection-check.mjs",
    "test:recovery": "node --experimental-strip-types scripts/recovery-selection-check.mjs",
    "test:persistence": "node --experimental-strip-types scripts/document-persistence-check.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
